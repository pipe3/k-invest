{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "ruff check .",
            "timeout": 30,
            "statusMessage": "ruff check läuft..."
          }
        ]
      }
    ]
  }
}
